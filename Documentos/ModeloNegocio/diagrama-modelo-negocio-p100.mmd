flowchart TB
  %% Modelo de negocio institucional del Proyecto Centenario (P100).
  %% Vista visual por capas: valor institucional, procesos, agentes, plataforma y resultados.

  subgraph contexto["1. Contexto y necesidad institucional"]
    seu["SEU / FIE<br/>gestion de extension universitaria"]
    necesidad["Necesidad de negocio<br/>mas demanda multicanal<br/>alta carga manual<br/>informacion dispersa<br/>evidencia auditable"]
    destinatarios["Destinatarios y partes interesadas<br/>Comunidad FIE, egresados, aspirantes,<br/>sector productivo, Defensa Nacional,<br/>organismos de control"]
  end

  subgraph valor["2. Propuesta de valor P100"]
    propuesta["Sistema modular de 5 agentes IA<br/>amplia capacidad operativa sin aumentar proporcionalmente<br/>recursos humanos ni infraestructura"]
    principios["Principios de negocio<br/>BPM + PDCA<br/>implementacion incremental<br/>bajo costo y soberania de datos<br/>human-in-the-loop"]
  end

  subgraph procesos["3. Procesos SEU cubiertos"]
    estrategicos["Procesos estrategicos<br/>P1 Planificacion estrategica -> A5<br/>P2 Vinculacion con el medio -> A3"]
    sustantivos["Procesos sustantivos<br/>P3 Diseno de actividades -> A1<br/>P4 Comunicacion y difusion -> A1<br/>P5 Programas/cursos -> A1 + A4<br/>P6 Eventos academicos -> A3 + A1"]
    soporte["Procesos de soporte<br/>P7 Conocimiento y memoria -> A2<br/>P8 Monitoreo y mejora -> A5<br/>P9 Atencion a comunidad -> A4"]
  end

  subgraph plataforma["4. Plataforma compartida"]
    workspace["Google Workspace<br/>Forms, Sheets, Docs, Drive, Gmail"]
    orquestacion["Orquestacion<br/>Apps Script + Scheduler<br/>event-driven + batch<br/>Celery/Redis cuando aplica"]
    backend["Backend IA<br/>Python/FastAPI<br/>Ollama + LangChain/LlamaIndex<br/>PostgreSQL"]
    trazabilidad["Trazabilidad<br/>logs, auditoria, DoD,<br/>evidencia CONEAU/SIU"]
  end

  subgraph agentes["5. Agentes especializados"]
    a1["A1 Extension Bot<br/>comunicacion institucional<br/>gacetillas, posts, newsletters,<br/>mails, confirmaciones, certificados"]
    a2["A2 Historia Viva<br/>memoria institucional<br/>repositorio, indexacion semantica,<br/>efemerides y recuperacion"]
    a3["A3 Vinculacion y Congresos<br/>oportunidades externas<br/>eventos, reportes, ceremonial<br/>con control humano"]
    a4["A4 Atencion a la Comunidad<br/>consultas y orientacion<br/>respuesta multicanal<br/>ventanilla virtual"]
    a5["A5 Monitoreo y Evaluacion<br/>RRSS, integridad CONEAU/SIU,<br/>KPIs, dashboards y alertas"]
  end

  subgraph interacciones["6. Interaccion entre agentes"]
    haciaA1["A1 como hub de comunicacion<br/>recibe insumos, no orquesta el sistema"]
    ia21["A2 -> A1<br/>contenido historico y efemerides"]
    ia31["A3 -> A1<br/>eventos y oportunidades para difusion"]
    ia41["A4 -> A1<br/>respuestas complejas y materiales de orientacion"]
    ia51["A5 -> A1<br/>datos normalizados y texto enriquecido"]
  end

  subgraph resultados["7. Resultados de negocio"]
    comunicacion["Comunicacion consistente<br/>mas piezas, mejor frecuencia,<br/>validacion antes de publicar"]
    conocimiento["Conocimiento institucional<br/>repositorio historico reutilizable"]
    vinculacion["Vinculacion fortalecida<br/>convenios, oportunidades y eventos"]
    atencion["Atencion y conversion<br/>consultas, orientacion e inscripciones"]
    decision["Gestion basada en datos<br/>KPIs, dashboards, alertas,<br/>rendicion de cuentas"]
    beneficios["Beneficios esperados<br/>menor carga operativa<br/>mayor presencia digital<br/>trazabilidad auditable<br/>bajo costo y sostenibilidad"]
  end

