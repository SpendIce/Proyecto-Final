flowchart LR
  %% Modelo de negocio institucional del Proyecto Centenario (P100).
  %% Fuente: documentacion consolidada de Contenido/bible, Contenido/Definicion y perfiles de Agentes.

  subgraph contexto["Contexto institucional"]
    seu["SEU / FIE<br/>Gestion de extension universitaria"]
    necesidad["Necesidad de negocio<br/>mas demanda multicanal<br/>carga operativa manual<br/>informacion dispersa<br/>trazabilidad exigible"]
    actores["Destinatarios y partes interesadas<br/>Comunidad FIE<br/>egresados y aspirantes<br/>sector productivo<br/>Defensa Nacional<br/>organismos de control"]
  end

  subgraph propuesta["Propuesta de valor del P100"]
    sistema["Sistema modular de 5 agentes IA<br/>apoyo a gestion de extension<br/>incremental, sostenible y de bajo costo"]
    enfoque["Modelo operativo<br/>BPM + PDCA<br/>event-driven + batch<br/>organizacion basada en procesos y datos"]
    supervision["Control institucional<br/>human-in-the-loop<br/>validacion humana antes de publicar, enviar o certificar"]
  end

  subgraph plataforma["Plataforma compartida"]
    workspace["Google Workspace<br/>Forms, Sheets, Docs, Drive, Gmail, Calendar"]
    bus["Google Sheets<br/>bus de datos operativo"]
    triggers["Apps Script + Scheduler<br/>triggers, automatizaciones y procesos batch"]
    backend["Backend IA<br/>Python/FastAPI, Ollama, LangChain/LlamaIndex,<br/>Celery + Redis, PostgreSQL"]
    evidencia["Trazabilidad<br/>logs, auditoria, DoD, evidencia CONEAU/SIU"]
  end

  subgraph procesos["Procesos de negocio SEU"]
    p1["P1 Planificacion estrategica<br/>metas, prioridades, indicadores"]
    p2["P2 Vinculacion con el medio<br/>convenios, oportunidades, contactos"]
    p3["P3 Diseno de actividades<br/>propuestas, proyectos, aprobaciones"]
    p4["P4 Comunicacion y difusion<br/>contenidos y canales institucionales"]
    p5["P5 Programas, cursos y diplomaturas<br/>inscripciones, seguimiento, certificados"]
    p6["P6 Eventos academicos<br/>jornadas, congresos, publicaciones asociadas"]
    p7["P7 Gestion del conocimiento<br/>repositorio y memoria institucional"]
    p8["P8 Monitoreo y mejora continua<br/>KPIs, dashboards, integridad de datos"]
    p9["P9 Atencion a comunidad y aspirantes<br/>consultas, orientacion, conversion"]
  end

  subgraph agentes["Agentes del sistema general"]
    a1["A1 Extension Bot<br/>comunicacion institucional<br/>gacetillas, posts, newsletters,<br/>mails, confirmaciones, certificados"]
    a2["A2 Historia Viva<br/>memoria institucional<br/>ingesta, indexacion semantica,<br/>efemerides y recuperacion"]
    a3["A3 Vinculacion y Congresos<br/>oportunidades externas<br/>eventos, reportes, ceremonial<br/>con control humano"]
    a4["A4 Atencion a la Comunidad<br/>respuestas automaticas<br/>orientacion multicanal<br/>ventanilla virtual"]
    a5["A5 Monitoreo y Evaluacion<br/>RRSS, integridad CONEAU/SIU,<br/>KPIs, dashboards y alertas"]
  end

  subgraph salidas["Productos y resultados de negocio"]
    comunicaciones["Comunicaciones institucionales<br/>publicaciones, correos, piezas web,<br/>newsletters y difusion de eventos"]
    conocimiento["Activo de conocimiento<br/>repositorio historico, efemerides,<br/>documentos recuperables"]
    vinculacion["Vinculacion fortalecida<br/>oportunidades, convenios, eventos,<br/>contacto institucional"]
    servicio["Servicio a usuarios<br/>consultas respondidas,<br/>orientacion e inscripciones"]
    decision["Gestion basada en datos<br/>tableros, KPIs, alertas,<br/>rendicion de cuentas"]
    beneficios["Beneficios esperados<br/>menor carga operativa<br/>mayor consistencia comunicacional<br/>trazabilidad auditable<br/>mayor presencia digital<br/>soberania y bajo costo"]
  end

