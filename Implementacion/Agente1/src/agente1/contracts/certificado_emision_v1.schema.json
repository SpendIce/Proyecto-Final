{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:p100:agente1:certificado-emision:v1",
  "title": "Entrada candidata HU-014",
  "type": "object",
  "additionalProperties": false,
  "x-contract-version": "certificado_emision_v1",
  "x-status": "PROVISIONAL_NO_INSTITUCIONAL",
  "description": "Contrato técnico offline. No constituye autorización de emisión ni criterio aprobado por SEU. La plantilla institucional y la firma digital quedan PENDIENTE_SEU.",
  "required": [
    "id_certificado",
    "nombre_titular",
    "documento_titular",
    "tipo_certificado",
    "actividad",
    "fecha",
    "organiza",
    "firmante"
  ],
  "properties": {
    "id_certificado": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"},
    "nombre_titular": {"type": "string", "minLength": 1},
    "documento_titular": {"type": "string", "minLength": 1},
    "tipo_certificado": {"type": "string", "enum": ["ASISTENCIA", "APROBACION"]},
    "actividad": {"type": "string", "minLength": 1},
    "fecha": {"type": "string", "minLength": 1},
    "organiza": {"type": "string", "minLength": 1},
    "firmante": {"type": "string", "minLength": 1}
  }
}
