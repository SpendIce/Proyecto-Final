{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:proyecto-centenario:agente1:entrada-gacetilla:cronica_de_evento:v1",
  "title": "Contrato de entrada de la gacetilla de cronica de evento",
  "description": "La cronica se carga con el titulo y el texto corrido que confirma una persona. No necesita actividad, modalidad, duracion ni inscripcion: esos campos no aplican.",
  "x-contract-version": "gacetilla_entrada_cronica_de_evento_v1",
  "x-status": "PROVISIONAL_NO_INSTITUCIONAL",
  "x-decision": "#121",
  "x-tipo": "cronica_de_evento",
  "x-modo": "extrae_y_confirma",
  "x-requiere_actividad": false,
  "x-interpretacion_fallback": false,
  "type": "object",
  "required": ["titulo", "cuerpo"],
  "no_aplican": [
    "id_actividad",
    "descripcion",
    "fecha_inicio",
    "fecha_fin",
    "fecha_limite_inscripcion",
    "hora",
    "modalidad",
    "duracion_horas",
    "publico",
    "organiza",
    "contacto",
    "fuente",
    "enlace_inscripcion",
    "lugar",
    "nombre",
    "rol",
    "dia",
    "hecho",
    "condicion",
    "area_emisora",
    "destinatarios",
    "convocatoria",
    "requisitos",
    "enlace_adjunto"
  ],
  "properties": {
    "titulo": {"type": "string", "minLength": 1},
    "cuerpo": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
