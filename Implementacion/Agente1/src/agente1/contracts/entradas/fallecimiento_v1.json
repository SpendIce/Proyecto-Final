{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:proyecto-centenario:agente1:entrada-gacetilla:fallecimiento:v1",
  "title": "Contrato de entrada de la gacetilla de fallecimiento",
  "description": "El fallecimiento se carga con nombre, rol, dia, hora y lugar confirmados por quien pide. Sin esos datos la pieza no se emite: el agente no inventa un nombre ni completa un hueco. No necesita actividad.",
  "x-contract-version": "gacetilla_entrada_fallecimiento_v1",
  "x-status": "PROVISIONAL_NO_INSTITUCIONAL",
  "x-decision": "#121",
  "x-tipo": "fallecimiento",
  "x-modo": "extrae_y_confirma",
  "x-requiere_actividad": false,
  "x-interpretacion_fallback": false,
  "type": "object",
  "required": ["titulo", "nombre", "rol", "dia", "hora", "lugar"],
  "no_aplican": [
    "id_actividad",
    "descripcion",
    "fecha_inicio",
    "fecha_fin",
    "fecha_limite_inscripcion",
    "modalidad",
    "duracion_horas",
    "publico",
    "organiza",
    "contacto",
    "fuente",
    "enlace_inscripcion",
    "area_emisora",
    "hecho",
    "condicion",
    "destinatarios",
    "convocatoria",
    "requisitos",
    "enlace_adjunto"
  ],
  "properties": {
    "titulo": {"type": "string", "minLength": 1},
    "nombre": {"type": "string", "minLength": 1},
    "rol": {"type": "string", "minLength": 1},
    "dia": {"type": "string", "minLength": 1},
    "hora": {"type": "string", "minLength": 1},
    "lugar": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
