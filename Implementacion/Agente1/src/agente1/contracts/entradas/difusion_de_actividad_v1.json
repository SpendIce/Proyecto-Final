{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:proyecto-centenario:agente1:entrada-gacetilla:difusion_de_actividad:v1",
  "title": "Contrato de entrada de la gacetilla de difusion de actividad",
  "description": "Campos que la difusion de actividad exige y campos que no aplican a esta clase. Reusa la planilla de actividades v2: es el unico tipo que necesita una actividad de la fuente.",
  "x-contract-version": "gacetilla_entrada_difusion_de_actividad_v1",
  "x-status": "PROVISIONAL_NO_INSTITUCIONAL",
  "x-decision": "#121",
  "x-tipo": "difusion_de_actividad",
  "x-modo": "genera",
  "x-requiere_actividad": true,
  "x-reusa": "gacetilla_input_v2",
  "x-interpretacion_fallback": true,
  "type": "object",
  "required": [
    "id_actividad",
    "titulo",
    "descripcion",
    "fecha_inicio",
    "publico",
    "organiza",
    "contacto",
    "fuente"
  ],
  "no_aplican": [
    "nombre",
    "rol",
    "dia",
    "hecho",
    "condicion",
    "area_emisora",
    "destinatarios",
    "convocatoria",
    "requisitos",
    "enlace_adjunto"
  ],
  "properties": {
    "id_actividad": {"type": "string", "minLength": 1},
    "titulo": {"type": "string", "minLength": 1},
    "descripcion": {"type": "string", "minLength": 1},
    "fecha_inicio": {"type": "string", "minLength": 1},
    "fecha_fin": {"type": "string", "x-required": false},
    "fecha_limite_inscripcion": {"type": "string", "x-required": false},
    "hora": {"type": "string", "x-required": false},
    "modalidad": {"type": "string", "x-required": false},
    "duracion_horas": {"type": "string", "x-required": false},
    "publico": {"type": "string", "minLength": 1},
    "organiza": {"type": "string", "minLength": 1},
    "contacto": {"type": "string", "minLength": 1},
    "fuente": {"type": "string", "minLength": 1},
    "enlace_inscripcion": {"type": "string", "x-required": false},
    "lugar": {"type": "string", "x-required": false}
  },
  "additionalProperties": true
}
