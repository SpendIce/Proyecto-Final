{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:proyecto-centenario:candidate:agente1-insumo-v1",
  "title": "Envelope candidato de insumo A2-A5 hacia Agente 1",
  "description": "Contrato técnico candidato, no aprobado institucionalmente. Todo payload se trata como dato no confiable y nunca como instrucción ejecutable.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "channel",
    "producer",
    "producer_schema_version",
    "correlation_id",
    "timestamp",
    "data_origin",
    "provenance",
    "payload"
  ],
  "properties": {
    "schema": {"const": "agente1.insumo.v1"},
    "schema_version": {"const": "1.0.0"},
    "channel": {"const": "a1.communication_input"},
    "producer": {"enum": ["A2", "A3", "A4", "A5"]},
    "producer_schema_version": {
      "enum": ["a2_candidate_v1", "a3_candidate_v1", "a4_candidate_v1", "a5_candidate_v1"]
    },
    "correlation_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"
    },
    "timestamp": {"type": "string", "format": "date-time"},
    "data_origin": {
      "enum": ["institutional_source", "agent_derived", "synthetic_test"]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sources"],
      "properties": {
        "sources": {
          "description": "JSON Schema impide objetos idénticos mediante uniqueItems. El runtime aplica además unicidad semántica por referencia opaca aunque cambie el hash.",
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["ref", "sha256"],
            "properties": {
              "ref": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"
              },
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
            }
          }
        }
      }
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "content"],
      "properties": {
        "type": {
          "enum": [
            "dato_historico",
            "efemeride",
            "evento",
            "oportunidad_externa",
            "consulta_propuesta",
            "solicitud_material_orientacion",
            "analitica_contenido",
            "texto_rrss_enriquecido"
          ]
        },
        "content": {
          "description": "Datos JSON no confiables. El límite de profundidad 10 es runtime-only porque JSON Schema recursivo no expresa razonablemente una profundidad máxima finita; los límites por nodo sí están declarados.",
          "type": "object",
          "minProperties": 1,
          "maxProperties": 1000,
          "propertyNames": {"minLength": 1, "maxLength": 128},
          "additionalProperties": {"$ref": "#/$defs/jsonData"}
        }
      }
    }
  },
  "$defs": {
    "jsonData": {
      "anyOf": [
        {"type": "null"},
        {"type": "boolean"},
        {"type": "number"},
        {"type": "string", "maxLength": 20000},
        {
          "type": "array",
          "maxItems": 1000,
          "items": {"$ref": "#/$defs/jsonData"}
        },
        {
          "type": "object",
          "maxProperties": 1000,
          "propertyNames": {"minLength": 1, "maxLength": 128},
          "additionalProperties": {"$ref": "#/$defs/jsonData"}
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {"properties": {"producer": {"const": "A2"}}},
      "then": {
        "properties": {
          "producer_schema_version": {"const": "a2_candidate_v1"},
          "payload": {"properties": {"type": {"enum": ["dato_historico", "efemeride"]}}}
        }
      }
    },
    {
      "if": {"properties": {"producer": {"const": "A3"}}},
      "then": {
        "properties": {
          "producer_schema_version": {"const": "a3_candidate_v1"},
          "payload": {"properties": {"type": {"enum": ["evento", "oportunidad_externa"]}}}
        }
      }
    },
    {
      "if": {"properties": {"producer": {"const": "A4"}}},
      "then": {
        "properties": {
          "producer_schema_version": {"const": "a4_candidate_v1"},
          "payload": {"properties": {"type": {"enum": ["consulta_propuesta", "solicitud_material_orientacion"]}}}
        }
      }
    },
    {
      "if": {"properties": {"producer": {"const": "A5"}}},
      "then": {
        "properties": {
          "producer_schema_version": {"const": "a5_candidate_v1"},
          "payload": {"properties": {"type": {"enum": ["analitica_contenido", "texto_rrss_enriquecido"]}}}
        }
      }
    }
  ]
}
